{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partes",
  "main": "worker.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "partes-db",
      "database_id": "4f86a835-2af1-4c30-9451-0cbffb0e9189"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "partes-fotos"
    }
  ]
}
